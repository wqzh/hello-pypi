
# ============================================================
# 多模型配置（推荐）
# ------------------------------------------------------------
# PI_MODELS 是逗号分隔的模型键；每个键对应一组 PI_MODEL_<KEY>_*
# 变量（键名中的非字母数字会转成下划线并大写）。
# 前端下拉框显示的名称是「供应商/模型名」：
#   供应商 = PROVIDER（留空时取 BASE_URL 的主机名）
#   模型名 = NAME（留空时取 MODEL_ID）
#
# PI_MODELS=qwen35,deepseek
#
# PI_MODEL_QWEN35_NAME=本地千问/Qwen3-35B
# PI_MODEL_QWEN35_MODEL_ID=qwen3-35b-a3b-gguf
# PI_MODEL_QWEN35_BASE_URL=http://115.190.184.39:9978/v1
# PI_MODEL_QWEN35_API_KEY=sk-xxx
# PI_MODEL_QWEN35_PROVIDER=wqzh-local
# PI_MODEL_QWEN35_API_TYPE=openai-completions
# PI_MODEL_QWEN35_CONTEXT_WINDOW=54000
# PI_MODEL_QWEN35_MAX_TOKENS=8192
# PI_MODEL_QWEN35_REASONING=false
#
# PI_MODEL_DEEPSEEK_NAME=DeepSeek/DeepSeek-Chat
# PI_MODEL_DEEPSEEK_MODEL_ID=deepseek-chat
# PI_MODEL_DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# PI_MODEL_DEEPSEEK_API_KEY=sk-yyy
# PI_MODEL_DEEPSEEK_PROVIDER=deepseek
#
# 可选：指定默认选中的模型键（不填则为 PI_MODELS 中第一个）
# PI_DEFAULT_MODEL=qwen35


# ============================================================
# 单模型配置（旧写法，保持兼容；PI_MODELS 未配置时生效）
# ============================================================

# Model Configuration (multiply model card)
PI_LLM_BASE_URL=https://xxxx/v1      # must
PI_LLM_MODEL_ID=gpt-4o               # must
PI_LLM_MODEL_NAME=gpt-4o   
PI_LLM_API_KEY="sk-xxx"              # must
PI_LLM_PROVIDER="openai"    

# PI_MODEL_DEEPSEEK_NAME=deepseek-v4-pro
# PI_MODEL_DEEPSEEK_MODEL_ID=deepseek-v4-pro
# PI_MODEL_DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# PI_MODEL_DEEPSEEK_API_KEY=sk-yyy
# PI_MODEL_DEEPSEEK_PROVIDER=deepseek


PI_LLM_API_TYPE=openai-completions  # change it if necessary

# `pi/pi_ai/providers/openai_provider.py`, used for compaction. see `debug_logs/ERRORs_solution.md`
PI_OPENAI_API_KEY=$PI_LLM_MODEL_ID   


# Model Context length
PI_LLM_CONTEXT_WINDOW=54000    # change it if necessary
PI_LLM_MAX_TOKENS=8192
PI_LLM_REASONING=false


####### TOOLS
##TOOL_QWEATHER_API_KEY="" #弃用 # https://console.qweather.com/setting?lang=zh， 【开发者ID】即 API_KEY
TOOL_TAVILY_SEARCH_API_KEY=""
